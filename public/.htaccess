# NGriffinPay — Hostinger (Apache / LiteSpeed) settings
# Lives in public/ so Vite copies it into dist/ → public_html on every build.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Always use HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Block direct access to the shared mail helper
  RewriteRule ^api/_ - [R=404,L]

  # 3) Form endpoints: /api/contact → api/contact.php (same URLs as on Vercel)
  RewriteRule ^api/(contact|demo|demo-popup|enquiry)/?$ api/$1.php [L]

  # 4) React Router: any other URL that is not a real file/folder → index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>

# Never serve these even if they end up on the server by mistake
<FilesMatch "(^\.|\.(env|log|md|json|lock|ya?ml|sh|ini)$|^ngp-mail-config\.php$)">
  Require all denied
</FilesMatch>
<FilesMatch "^(manifest\.json|site\.webmanifest)$">
  Require all granted
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Caching (same as vercel.json): hashed build files 1 year, images 30 days, HTML never
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
